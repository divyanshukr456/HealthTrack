{
  "info": {
    "name": "HealthTrack - Step 3",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run Auth > Login first (the token cookie is stored automatically), then run each folder top to bottom."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"Passw0rd!123\",\n  \"dob\": \"1995-05-05\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"Passw0rd!123\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Daily Records",
      "item": [
        {
          "name": "Create",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j=pm.response.json();",
                  "if(j.data&&j.data.item){pm.collectionVariables.set(\"dailyId\",j.data.item._id);}",
                  "pm.test(\"success\",()=>pm.expect(j.success).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/daily-records",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"2026-11-09\",\n  \"steps\": 8000,\n  \"waterIntake\": 2000,\n  \"weight\": 70.5,\n  \"caloriesBurned\": 400\n}"
            }
          }
        },
        {
          "name": "List (filters + pagination)",
          "event": [],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/daily-records?page=1&limit=20&order=desc"
          }
        },
        {
          "name": "Get one",
          "event": [],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/daily-records/{{dailyId}}"
          }
        },
        {
          "name": "Update",
          "event": [],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/daily-records/{{dailyId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"steps\": 9500\n}"
            }
          }
        },
        {
          "name": "Delete",
          "event": [],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/daily-records/{{dailyId}}"
