# Copy this file to .env and fill in real values. Never commit .env.
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5500

# MongoDB Atlas connection string. Include the database name (healthtrack).
# URL-encode special characters in the password (@ -> %40, # -> %23).
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/healthtrack?retryWrites=true&w=majority

# bcrypt cost factor (10-15)
BCRYPT_SALT_ROUNDS=12

# JWT signing secret (min 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
# Login session length in days (JWT expiry and cookie lifetime)
JWT_EXPIRES_IN_DAYS=7
